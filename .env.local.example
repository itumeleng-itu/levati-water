# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Canonical production origin — app/sitemap.ts and app/robots.ts. Defaults to
# https://levatiwater.com if unset (lib/site.ts).
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile — spec §8. Site key is public (client-side widget),
# secret key is server-only (route handler verification). Get both at
# https://dash.cloudflare.com/ → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — email delivery for /free-trial and /contact (lib/send-email.ts).
# RESEND_FROM_EMAIL's domain must be verified in the Resend dashboard before
# mail will actually send. LEADS_TO_EMAIL is where submissions land.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEADS_TO_EMAIL=
